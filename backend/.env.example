# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smart-document-generator-acm-svnit.vercel.app

# Security Secrets
JWT_SECRET_KEY=acm_svnit_smart_docs_jwt_secret_key_2026_super_secure
OTP_SECRET_KEY=acm_svnit_smart_docs_otp_secret_key_2026
ADMIN_BOOTSTRAP_SECRET=svnit_acm_admin_bootstrap_secret_2026

# Email / SMTP Configuration (Optional in local dev; required for real inbox delivery)
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="SmartDocs SVNIT · ACM Student Chapter"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional Intelligent Extraction Fallback (Requirement 9)
GEMINI_API_KEY=
OPENAI_API_KEY=
