# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smart-document-generator-acm-svnit.vercel.app

# Security Secrets
JWT_SECRET_KEY=acm_svnit_smart_docs_jwt_secret_key_2026_super_secure
OTP_SECRET_KEY=acm_svnit_smart_docs_otp_secret_key_2026
ADMIN_BOOTSTRAP_SECRET=svnit_acm_admin_bootstrap_secret_2026

# Resend HTTPS API Email Configuration (Recommended for Render, Vercel & Production)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Address:
# 1. Default testing address (before domain verification): onboarding@resend.dev
#    Note: onboarding@resend.dev only allows sending to the email registered on your Resend account.
# 2. Production (after verifying your custom domain in Resend):
#    EMAIL_FROM="SmartDocs SVNIT <noreply@yourdomain.com>"
EMAIL_FROM="SmartDocs SVNIT <onboarding@resend.dev>"

# Optional Intelligent Extraction Fallback (Requirement 9)
GEMINI_API_KEY=
OPENAI_API_KEY=
