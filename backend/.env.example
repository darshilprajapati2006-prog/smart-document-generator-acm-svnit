# Backend Environment Configuration
PORT=8000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Intelligent Extraction Fallback (Requirement 9)
# If provided, enables LLM fallback extraction when deterministic parser yields sparse output.
# If omitted, application operates with 100% deterministic local extraction without crashing.
GEMINI_API_KEY=
OPENAI_API_KEY=

